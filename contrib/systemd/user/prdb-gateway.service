[Unit]
Description=PRDB client gateway
Requires=prdb-supervisor.service
After=prdb-supervisor.service

[Service]
Type=simple
EnvironmentFile=%h/.config/prdb/gateway.env
ExecStart=%h/.local/libexec/prdb/prdb-gateway $PRDB_GATEWAY_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
