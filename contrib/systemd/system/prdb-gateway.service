[Unit]
Description=PRDB client gateway
Requires=prdb-supervisor.service
After=prdb-supervisor.service

[Service]
Type=simple
User=prdb-gateway
Group=prdb-gateway
EnvironmentFile=/etc/prdb/gateway.env
ExecStart=/usr/libexec/prdb/prdb-gateway $PRDB_GATEWAY_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
