[Unit]
Description=PRDB client gateway
Requires=prdb-supervisor.service
After=prdb-supervisor.service

[Service]
Type=simple
User=prdb-gateway
Group=prdb-gateway
EnvironmentFile=/etc/prdb/gateway.env
Environment=PATH=/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/libexec/prdb/prdb-landlock-run --traverse-env PRDB_GATEWAY_LANDLOCK_TRAVERSE_PATHS --read-execute /usr/libexec/prdb/prdb-gateway --read-execute-env PRDB_GATEWAY_LANDLOCK_PATHS --read /run/prdb -- /usr/libexec/prdb/prdb-gateway $PRDB_GATEWAY_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
