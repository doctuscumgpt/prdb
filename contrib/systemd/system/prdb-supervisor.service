[Unit]
Description=PRDB database supervisor
After=local-fs.target

[Service]
Type=simple
User=prdb
Group=prdb-gateway
Delegate=cpu memory pids
StateDirectory=prdb/scratch
StateDirectoryMode=0700
RuntimeDirectory=prdb
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/prdb/supervisor.env
Environment=PATH=/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/libexec/prdb/with_delegated_cgroup.sh /usr/libexec/prdb/prdb-landlock-run --traverse-env PRDB_LANDLOCK_TRAVERSE_PATHS --traverse /dev --read-execute /usr/libexec/prdb/prdb-supervisor --read-write-file /dev/null --writable /var/lib/prdb --writable /run/prdb --writable-env PRDB_SYSTEMD_CGROUP_PARENT --read-execute-env PRDB_SUPERVISOR_LANDLOCK_PATHS -- /usr/libexec/prdb/prdb-supervisor $PRDB_SUPERVISOR_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/prdb /run/prdb

[Install]
WantedBy=multi-user.target
