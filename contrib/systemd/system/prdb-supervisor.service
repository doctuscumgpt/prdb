[Unit]
Description=PRDB database supervisor
After=local-fs.target

[Service]
Type=simple
User=prdb
Group=prdb-gateway
Delegate=cpu memory pids
StateDirectory=prdb/scratch
StateDirectoryMode=0700
RuntimeDirectory=prdb
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/prdb/supervisor.env
ExecStart=/usr/libexec/prdb/with_delegated_cgroup.sh /usr/libexec/prdb/prdb-supervisor $PRDB_SUPERVISOR_ARGS
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/prdb /run/prdb

[Install]
WantedBy=multi-user.target
